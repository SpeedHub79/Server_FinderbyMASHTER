local function createServerEntry(serverData)
	local clone = ServerTemplate:Clone()

	clone.Name = "ServerFrameClone"
	clone.Visible = true
	clone.Parent = ServerList

	local serverName = clone:FindFirstChild("ServerName")
	local entryGameId = clone:FindFirstChild("EntryGameId")
	local entryServerId = clone:FindFirstChild("EntryServerId")
	local playerCount = clone:FindFirstChild("PlayerCount")
	local join = clone:FindFirstChild("Join")

	serverName.Text = gameName

	entryGameId.Text =
		"Game ID: " .. tostring(game.PlaceId)

	entryServerId.Text =
		"Server ID: " .. tostring(serverData.id)

	playerCount.Text = string.format(
		"%d / %d",
		tonumber(serverData.playing) or 0,
		tonumber(serverData.maxPlayers) or 0
	)

	join.MouseButton1Click:Connect(function()
		pcall(function()
			TeleportService:TeleportToPlaceInstance(
				game.PlaceId,
				serverData.id,
				LocalPlayer
			)
		end)
	end)
end

local function fetchServers(cursor)
	local url = string.format(
		"https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
		game.PlaceId
	)

	if cursor then
		url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
	end

	local success, response = pcall(function()
		return requestFunc({
			Url = url,
			Method = "GET"
		})
	end)

	if success and response and response.Body then
		local decodeSuccess, data = pcall(function()
			return HttpService:JSONDecode(response.Body)
		end)

		if decodeSuccess then
			return data
		end
	end

	return nil
end

task.spawn(function()
	local servers = {}
	local cursor = nil

	repeat
		local data = fetchServers(cursor)

		if not data or not data.data then
			break
		end

		for _, server in ipairs(data.data) do
			if server.id
				and server.playing
				and server.maxPlayers
				and server.playing < server.maxPlayers then

				table.insert(servers, server)
			end
		end

		cursor = data.nextPageCursor

		task.wait(0.1)
	until not cursor

	table.sort(servers, function(a, b)
		return a.playing < b.playing
	end)

	for _, server in ipairs(servers) do
		createServerEntry(server)
	end
end)

MakeDraggable(Main)
MakeDraggable(Logo)

task.spawn(function()
	while Gui.Parent do
		if not isAnimating then
			local up = TweenService:Create(
				LogoScale,
				TweenInfo.new(
					1.3,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{Scale = 1.04}
			)

			up:Play()
			up.Completed:Wait()

			if not Gui.Parent then
				break
			end

			local down = TweenService:Create(
				LogoScale,
				TweenInfo.new(
					1.3,
					Enum.EasingStyle.Sine,
					Enum.EasingDirection.InOut
				),
				{Scale = 1}
			)

			down:Play()
			down.Completed:Wait()
		else
			task.wait(0.1)
		end
	end
end)
